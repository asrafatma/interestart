---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/siteConfig';
---

<Layout title="Connect" description="Reach out to InterestArt at itsasrafatma@gmail.com. Submit questions, art suggestions, or study collaboration proposals.">
  <div class="contact-header">
    <div class="container text-center">
      <span class="contact-badge">Get in Touch</span>
      <h1>Let's Connect</h1>
      <p class="contact-sub">Have questions about a sketching tutorial, feedback, or a studio collaboration proposal? Reach out directly or fill out the form below.</p>
    </div>
  </div>

  <div class="container contact-main">
    <div class="contact-layout-grid">
      <!-- Contact Info Sidebar -->
      <div class="contact-details-side">
        <span class="section-kicker">Direct Reach</span>
        <h2>Contact Information</h2>
        <p class="contact-intro">I read every message and try to respond promptly. Art studies, feedback, and creative inquiries are always welcome.</p>
        
        <ul class="contact-info-list">
          <li class="info-card">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div class="info-meta">
              <span class="info-label">Direct Email</span>
              <a href={`mailto:${siteConfig.contactEmail}`} class="info-val">{siteConfig.contactEmail}</a>
            </div>
          </li>
          
          <li class="info-card">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div class="info-meta">
              <span class="info-label">Location</span>
              <span class="info-val">Art Studio Desk</span>
            </div>
          </li>

          <li class="info-card">
            <div class="info-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div class="info-meta">
              <span class="info-label">Response Window</span>
              <span class="info-val">24 – 48 Hours</span>
            </div>
          </li>
        </ul>

        <div class="pinterest-box">
          <div class="pinterest-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="color: #bd081c;"><path d="M12 0C5.373 0 0 5.372 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.065-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738.098.119.112.224.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.631-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12 0-6.628-5.373-12-12-12z"/></svg>
            <h3>Pinterest Moodboards</h3>
          </div>
          <p>Explore weekly color palettes, sketchbook loops, and classical shading references.</p>
          <a href={siteConfig.social.pinterest} class="cta-btn pinterest-btn" target="_blank" rel="noopener noreferrer">
            Visit InterestArt Pinterest &rarr;
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="contact-form-side">
        <div class="form-card">
          <!-- Inline Status Updates -->
          <div id="contact-success" class="status-panel success" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;flex-shrink:0;"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <div>
              <strong>Message Sent Successfully!</strong>
              <p style="font-size:0.82rem; margin-top:0.25rem; line-height: 1.5;">Thank you for reaching out. Your message has been received.</p>
            </div>
          </div>
          
          <div id="contact-error" class="status-panel error" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;flex-shrink:0;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            <span id="contact-error-text">Please complete all required fields before submitting.</span>
          </div>

          <form id="studio-contact-form" novalidate>
            <div class="form-row">
              <div class="form-group">
                <label for="contact-name">Full Name</label>
                <input type="text" id="contact-name" placeholder="e.g. Asra Fatma" required aria-required="true" />
              </div>
              
              <div class="form-group">
                <label for="contact-email">Email Address</label>
                <input type="email" id="contact-email" placeholder="yourname@example.com" required aria-required="true" />
              </div>
            </div>

            <div class="form-group">
              <label for="contact-topic">Subject / Topic</label>
              <input type="text" id="contact-topic" placeholder="Collaboration / General Inquiry / Sketching Idea" required aria-required="true" />
            </div>

            <div class="form-group">
              <label for="contact-message">Your Message</label>
              <textarea id="contact-message" rows="5" placeholder="Share your message or questions here..." required aria-required="true"></textarea>
            </div>

            <label class="form-checkbox">
              <input type="checkbox" id="contact-newsletter-subscribe" checked />
              <span>Subscribe to the weekly artist newsletter for studio guides and creative prompts.</span>
            </label>

            <button type="submit" class="cta-btn submit-btn">
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .contact-header {
    padding: 4.5rem 0 3rem 0;
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .contact-badge {
    font-family: var(--font-display);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 700;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.5rem;
  }
  .contact-header h1 {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }
  .contact-sub {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .contact-main {
    padding: 4.5rem 1.5rem;
  }

  .contact-layout-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 4rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .contact-layout-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .section-kicker {
    font-family: var(--font-display);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.35rem;
  }
  .contact-details-side h2 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }
  .contact-intro {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .contact-info-list {
    list-style: none;
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .info-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: var(--transition-fast);
  }
  .info-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-1px);
  }
  .info-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface-soft);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .info-meta {
    display: flex;
    flex-direction: column;
  }
  .info-label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
    color: var(--color-accent);
    margin-bottom: 0.15rem;
  }
  .info-val {
    font-size: 0.92rem;
    color: var(--color-text);
    font-weight: 600;
    text-decoration: none;
    transition: var(--transition-fast);
  }
  a.info-val:hover {
    color: var(--color-accent);
  }

  .pinterest-box {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
  }
  .pinterest-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .pinterest-box h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
  }
  .pinterest-box p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }
  .pinterest-btn {
    font-family: var(--font-display);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    display: inline-flex;
    padding: 0.6rem 1.2rem;
  }

  /* Form Side */
  .form-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.25rem;
    box-shadow: var(--shadow-sm);
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 600px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-group {
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .form-group label {
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text);
  }
  .form-group input, .form-group textarea {
    width: 100%;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-text);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    transition: var(--transition-fast);
  }
  .form-group input:focus, .form-group textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(139, 95, 90, 0.15);
  }

  .form-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.84rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 1.25rem 0 1.75rem 0;
    cursor: pointer;
  }
  .form-checkbox input {
    margin-top: 0.2rem;
    accent-color: var(--color-accent);
  }

  .submit-btn {
    width: 100%;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-sm);
  }

  /* Status Panels */
  .status-panel {
    display: none;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem;
    border-radius: var(--radius-sm);
    margin-bottom: 1.5rem;
    font-size: 0.88rem;
  }
  .status-panel.success {
    background-color: rgba(184, 195, 176, 0.25);
    border: 1px solid var(--color-sage);
    color: var(--color-text);
  }
  .status-panel.error {
    background-color: rgba(232, 199, 192, 0.25);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
  }

  .text-center {
    text-align: center;
  }
</style>

<script>
  // Accessible form validation script
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("studio-contact-form") as HTMLFormElement;
    const nameInput = document.getElementById("contact-name") as HTMLInputElement;
    const emailInput = document.getElementById("contact-email") as HTMLInputElement;
    const topicInput = document.getElementById("contact-topic") as HTMLInputElement;
    const messageInput = document.getElementById("contact-message") as HTMLTextAreaElement;
    
    const successPanel = document.getElementById("contact-success") as HTMLDivElement;
    const errorPanel = document.getElementById("contact-error") as HTMLDivElement;
    const errorText = document.getElementById("contact-error-text") as HTMLSpanElement;

    if (form) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        
        // Reset panels
        successPanel.style.display = "none";
        errorPanel.style.display = "none";

        let errors: string[] = [];

        // Validate name
        if (!nameInput.value.trim()) {
          errors.push("Full Name is required.");
          nameInput.style.borderColor = "var(--color-accent)";
        } else {
          nameInput.style.borderColor = "var(--color-border)";
        }

        // Validate email
        const email = emailInput.value.trim();
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!email) {
          errors.push("Email Address is required.");
          emailInput.style.borderColor = "var(--color-accent)";
        } else if (!emailRegex.test(email)) {
          errors.push("Please enter a valid email address.");
          emailInput.style.borderColor = "var(--color-accent)";
        } else {
          emailInput.style.borderColor = "var(--color-border)";
        }

        // Validate topic
        if (!topicInput.value.trim()) {
          errors.push("Topic is required.");
          topicInput.style.borderColor = "var(--color-accent)";
        } else {
          topicInput.style.borderColor = "var(--color-border)";
        }

        // Validate message
        if (!messageInput.value.trim()) {
          errors.push("Message body is required.");
          messageInput.style.borderColor = "var(--color-accent)";
        } else {
          messageInput.style.borderColor = "var(--color-border)";
        }

        if (errors.length > 0) {
          errorText.textContent = errors[0]; // Show first error
          errorPanel.style.display = "flex";
          errorPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          return;
        }

        // Form valid: Submit to Formspree via AJAX
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
        const originalBtnText = submitBtn.textContent;
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending...";

        const newsletterCheckbox = document.getElementById("contact-newsletter-subscribe") as HTMLInputElement;

        fetch("https://formspree.io/f/xljrjjrl", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          body: JSON.stringify({
            name: nameInput.value.trim(),
            email: emailInput.value.trim(),
            subject: topicInput.value.trim(),
            _subject: `New Contact Form Message: ${topicInput.value.trim()}`,
            message: messageInput.value.trim(),
            newsletter_subscribe: newsletterCheckbox?.checked ? "Yes" : "No"
          })
        })
        .then(async (response) => {
          if (response.ok) {
            successPanel.style.display = "flex";
            form.reset();
            successPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            const json = await response.json().catch(() => null);
            const message = json?.errors?.map((err: any) => err.message).join(" ");
            errorText.textContent = message || "Something went wrong. Please try again later.";
            errorPanel.style.display = "flex";
            errorPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }
        })
        .catch(() => {
          errorText.textContent = "Something went wrong. Please check your internet connection and try again.";
          errorPanel.style.display = "flex";
          errorPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        })
        .finally(() => {
          submitBtn.disabled = false;
          submitBtn.textContent = originalBtnText;
        });
      });
    }
  });
</script>
