---
interface Props {
  post: {
    id: string;
    data: {
      title: string;
      excerpt: string;
      category: string;
      categorySlug: string;
      displayDate: string;
      readTime: string;
      heroImage: string;
      heroAlt: string;
      author: string;
    };
  };
}

const { post } = Astro.props;
const authorInitials = post.data.author.split(' ').map(n => n[0]).join('');
---

<article class="masonry-item" data-id={post.id} data-category={post.data.category} data-title={post.data.title.toLowerCase()} data-excerpt={post.data.excerpt.toLowerCase()}>
  <div class="card-img-wrapper">
    <img src={post.data.heroImage} alt={post.data.heroAlt} loading="lazy" width="400" height="300" />
    <div class="card-overlay">
      <!-- Save (Pin) Button -->
      <button class="pin-save-btn" data-slug={post.id} aria-label={`Save ${post.data.title} study board`}>
        Save
      </button>
      <a href={`/blog/${post.id}/`} class="card-action-circle" title={`Read ${post.data.title}`} aria-label={`Read ${post.data.title}`}>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 16px; height: 16px;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
      </a>
    </div>
  </div>
  
  <div class="card-content">
    <div class="card-meta">
      <a href={`/${post.data.categorySlug}/`} class="card-category">{post.data.category}</a>
      <span aria-hidden="true">&middot;</span>
      <span>{post.data.readTime}</span>
    </div>
    
    <h3 class="card-title">
      <a href={`/blog/${post.id}/`}>{post.data.title}</a>
    </h3>
    
    <p class="card-excerpt">{post.data.excerpt}</p>
    
    <div class="card-footer">
      <span class="card-author">
        <span class="card-avatar" aria-hidden="true">{authorInitials}</span>
        <span>{post.data.author}</span>
      </span>
      <span>{post.data.displayDate}</span>
    </div>
  </div>
</article>

<script>
  // Dynamic client-side save state
  document.addEventListener("DOMContentLoaded", () => {
    const saveBtns = document.querySelectorAll(".pin-save-btn");
    let savedPins = JSON.parse(localStorage.getItem("saved_pins") || "[]");

    saveBtns.forEach(btn => {
      const btnEl = btn as HTMLButtonElement;
      const slug = btnEl.dataset.slug || "";
      
      // Initial state
      if (savedPins.includes(slug)) {
        btnEl.classList.add("saved");
        btnEl.textContent = "Saved";
      }

      btnEl.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        savedPins = JSON.parse(localStorage.getItem("saved_pins") || "[]");
        const idx = savedPins.indexOf(slug);
        
        if (idx === -1) {
          savedPins.push(slug);
          btnEl.classList.add("saved");
          btnEl.textContent = "Saved";
        } else {
          savedPins.splice(idx, 1);
          btnEl.classList.remove("saved");
          btnEl.textContent = "Save";
        }
        
        localStorage.setItem("saved_pins", JSON.stringify(savedPins));
      });
    });
  });
</script>
