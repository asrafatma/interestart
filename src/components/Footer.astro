---
import { siteConfig } from '../data/siteConfig';

const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="logo" aria-label="InterestArt Home">
          {siteConfig.siteName}<span class="logo-dot" aria-hidden="true"></span>
        </a>
        <p class="footer-desc">
          {siteConfig.description}
        </p>
        <div class="footer-socials">
          <a href={siteConfig.social.pinterest} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Follow InterestArt on Pinterest">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><path d="M8 22c-.67 0-1.34-.14-1.93-.41-.53-.25-1-.62-1.38-1.07-.38-.45-.66-.98-.82-1.55-.16-.58-.21-1.22-.16-1.89l.86-9.84c.05-.59.21-1.16.48-1.68.27-.51.63-.96 1.07-1.32.44-.36.95-.62 1.51-.76C8.19 3.35 8.78 3.3 9.38 3.35c.78.07 1.54.29 2.22.66.68.37 1.25.88 1.69 1.5.44.62.74 1.34.87 2.11.13.77.1 1.56-.1 2.32l-1.3 4.96c-.15.58-.42 1.12-.79 1.58-.37.46-.84.82-1.38 1.05-.54.23-1.13.34-1.72.32-.59-.02-1.17-.18-1.68-.47L8 22z"></path></svg>
          </a>
          <a href={siteConfig.social.instagram} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Follow InterestArt on Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href={siteConfig.social.github} class="social-link" target="_blank" rel="noopener noreferrer" aria-label="Follow InterestArt on GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
          </a>
          <a href="/rss.xml" class="social-link" aria-label="InterestArt RSS Feed">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="width:16px;height:16px;"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
          </a>
        </div>
      </div>

      <!-- Explore Link Column -->
      <div class="footer-col">
        <h4>Explore</h4>
        <ul class="footer-links">
          {siteConfig.footerLinks.explore.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Topics Column -->
      <div class="footer-col">
        <h4>Topics</h4>
        <ul class="footer-links">
          <li><a href="/painting/">Painting</a></li>
          <li><a href="/drawing/">Drawing</a></li>
          <li><a href="/digital-art/">Digital Art</a></li>
          <li><a href="/art-history/">Art History</a></li>
        </ul>
      </div>

      <!-- Legal Links Column -->
      <div class="footer-col">
        <h4>Resources</h4>
        <ul class="footer-links">
          {siteConfig.footerLinks.legal.map((link) => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="footer-bottom">
      <p>&copy; {currentYear} {siteConfig.siteName}. All rights reserved.</p>
      <p>Handcrafted with love for code and canvas.</p>
    </div>
  </div>
</footer>
