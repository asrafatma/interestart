---
import { siteConfig } from '../data/siteConfig';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  section?: string;
  jsonLd?: any;
}

const {
  title,
  description = siteConfig.description,
  canonicalUrl = Astro.url.href,
  ogImage = siteConfig.defaultSocialImage,
  type = 'website',
  publishedTime,
  modifiedTime,
  section,
  jsonLd
} = Astro.props;

const pageTitle = title ? `${title} | ${siteConfig.siteName}` : `${siteConfig.siteName} | ${siteConfig.tagline}`;

// Standard schema configurations
const defaultJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": siteConfig.siteName,
  "url": siteConfig.siteUrl,
  "description": siteConfig.tagline,
  "author": {
    "@type": "Person",
    "name": siteConfig.author.name,
    "url": new URL("/about/", siteConfig.siteUrl).href
  },
  "publisher": {
    "@type": "Organization",
    "name": siteConfig.siteName,
    "url": siteConfig.siteUrl,
    "founder": {
      "@type": "Person",
      "name": siteConfig.author.name,
      "url": new URL("/about/", siteConfig.siteUrl).href
    }
  }
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <!-- Pinterest Domain Verification -->
    <meta name="p:domain_verify" content="2454ac9ffe1ed8b33271fff2ff2000d2" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title || siteConfig.siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, siteConfig.siteUrl).href} />
    <meta property="og:site_name" content={siteConfig.siteName} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {section && <meta property="article:section" content={section} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title || siteConfig.siteName} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, siteConfig.siteUrl).href} />

    <!-- Favicon and RSS -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.siteName} RSS Feed`} href="/rss.xml" />

    <!-- Google tag (gtag.js) -->
    <script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-65CJJWC7J9"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-65CJJWC7J9');
    </script>

    <!-- Inline Theme Initializer script (Runs synchronously before DOM renders to prevent theme flash) -->
    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem("theme");
        const systemPrefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (savedTheme === "dark" || (!savedTheme && systemPrefersDark)) {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd || defaultJsonLd)} />

  </head>
  <body>
    <!-- Skip to main content link for screen readers -->
    <a href="#main-content" class="skip-link">Skip to content</a>

    <!-- Header Navigation -->
    <Header activeHref={Astro.url.pathname} />

    <!-- Main Content Wrapper -->
    <main id="main-content">
      <slot />
    </main>

    <!-- Footer section -->
    <Footer />

    <!-- Pinterest-style hover "Save" button on article and content images -->
    <script>
      function initPinHoverButtons() {
        const images = document.querySelectorAll<HTMLImageElement>(
          '.post-body img, .featured-img-wrapper img'
        );

        images.forEach((img) => {
          const host = img.parentElement;
          if (!host || host.classList.contains('pin-hover-host')) return;

          host.classList.add('pin-hover-host');

          const src = img.getAttribute('src') || '';
          const mediaUrl = new URL(src, window.location.href).href;
          const description = img.getAttribute('alt') || document.title;

          const btn = document.createElement('a');
          btn.className = 'pin-hover-save';
          btn.textContent = 'Save';
          btn.target = '_blank';
          btn.rel = 'noopener noreferrer';
          btn.setAttribute('aria-label', `Save this image to Pinterest`);
          btn.href = `https://pinterest.com/pin/create/button/?url=${encodeURIComponent(window.location.href)}&media=${encodeURIComponent(mediaUrl)}&description=${encodeURIComponent(description)}`;

          host.appendChild(btn);
        });
      }

      document.addEventListener('DOMContentLoaded', initPinHoverButtons);
    </script>
  </body>
</html>
